{
  "name": "pill-ark",
  "version": "0.1.3",
  "description": "A system tray app for tracking AI agent tasks",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "vite build",
    "build": "tauri build --bundles app && npm run build:dmg",
    "build:app": "tauri build --bundles app",
    "build:mac": "tauri build --bundles app && npm run build:dmg",
    "build:win": "tauri build --bundles nsis",
    "build:dmg": "node scripts/build-dmg.mjs",
    "preview": "tauri preview"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "build": "^0.1.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
